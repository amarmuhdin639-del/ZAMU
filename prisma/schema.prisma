generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN
  city         String?
  address      String?
  telegram     String?
  whatsapp     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  Session[]
  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============ CATALOG ============

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sku         String   @unique
  description String
  price       Float
  salePrice   Float?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  // when the product sits in the catch-all "Others" category, the owner writes the real type name here (e.g. "Traditional Shawl") and the storefront shows it instead of "Others"
  customCategory String?
  stock       Int      @default(0)
  sizes       String   @default("S,M,L,XL") // comma separated
  colors      String   @default("Black") // JSON: [{"name":"Black","hex":"#111111"}]
  featured    Boolean  @default(false)
  isNew       Boolean  @default(false)
  bestSeller  Boolean  @default(false)
  active      Boolean  @default(true)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images    ProductImage[]
  reviews   Review[]
  favorites Favorite[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

// ============ ORDERS & PAYMENTS ============

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  customerName   String
  phone          String
  email          String?
  city           String
  address        String
  notes          String?
  telegram       String?
  whatsapp       String?
  subtotal       Float
  deliveryFee    Float
  discount       Float    @default(0)
  total          Float
  discountCode   String?
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  paymentStatus  String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  status         String   @default("ORDER_PLACED") // ORDER_PLACED | PAYMENT_PENDING | PAYMENT_VERIFIED | PREPARING | READY_FOR_DELIVERY | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  adminNotes     String?
  rejectionReason String?
  rejectionReasonEn String? // auto-translated (LLM) for EN/AM customers
  rejectionReasonAm String?
  estimatedDelivery String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items    OrderItem[]
  payment  Payment?
  updates  OrderUpdate[]
}

// Fulfillment timeline: one row per step the admin advances the order
// through. Rows with informed=true are shown to the customer on /track.
model OrderUpdate {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       String
  message      String?  // note written by the admin (original language)
  messageEn    String?  // auto-translated for EN viewers
  messageAm    String?  // auto-translated for AM viewers
  trackingCode String?
  informed     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  image     String?
  price     Float
  qty       Int
  size      String
  color     String
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  methodName     String
  transactionRef String
  payerName      String
  screenshotPath String?
  amount         Float
  status         String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewedBy     String?
  reviewedAt     DateTime?
  rejectionReason String?
  rejectionReasonEn String? // auto-translated (LLM) for EN/AM customers
  rejectionReasonAm String?
  createdAt      DateTime @default(now())
}

model PaymentMethod {
  id            String  @id @default(cuid())
  name          String
  accountNumber String
  accountName   String
  phone         String?
  instructions  String?
  logo          String?
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
}

// ============ ENGAGEMENT ============

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  rating    Int
  comment   String
  image     String?
  verified  Boolean  @default(false)
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============ MARKETING ============

model DiscountCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    // PERCENT | FIXED
  value     Float
  minOrder  Float     @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  usageLimit Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  link      String?
  type      String  @default("PROMO") // PROMO | NEW_DROP | FLASH
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

// ============ CONFIG ============

model DeliveryZone {
  id            String  @id @default(cuid())
  name          String
  fee           Float
  estimatedDays String?
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  orders Order[]
}

model StoreSetting {
  key   String @id
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  adminName String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  audience  String   // ADMIN | CUSTOMER
  userId    String?
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Uploads stored INSIDE the database so they survive server restarts,
// sandbox restores and multi-instance deployments (disk files get wiped;
// the sqlite db is committed to git after every write by the persist guard).
model MediaAsset {
  id        String   @id @default(cuid())
  path      String   @unique // e.g. "products/abc123.png" (no /uploads/ prefix)
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
